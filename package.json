{
  "name": "english-tales",
  "version": "1.0.0",
  "description": "유튜브 이야기 채널 자막으로 문장 발음·해석·단어를 공부하는 안드로이드 영어 학습 앱",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "node scripts/build-data.mjs && node scripts/build-info.mjs",
    "dev": "npm run build && node dev/server.js",
    "test": "node --test \"test/**/*.test.js\"",
    "check": "node scripts/check.mjs",
    "android:sync": "npm run build && npx cap sync android"
  },
  "engines": {
    "node": ">=22.9"
  },
  "appRepo": "Kevin-KIM98/english-tales",
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "cmu-pronouncing-dictionary": "^3.0.0",
    "subtlex-word-frequencies": "^2.0.0"
  },
  "dependencies": {
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.2"
  }
}
